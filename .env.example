# OpenAI API key for LLM-powered agents (optional — Google Translate fallback works without it)
# Get your key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default source language (ISO 639-1 or BCP 47)
DEFAULT_SOURCE_LOCALE=en

# Comma-separated target locales for Asia-Pacific travel markets
TARGET_LOCALES=th,ja,ko,zh-CN,vi,id,ms

# QA pass threshold (0.0 - 1.0)
QA_SCORE_THRESHOLD=0.75

# Max retries for failed agent steps
MAX_RETRIES=2
